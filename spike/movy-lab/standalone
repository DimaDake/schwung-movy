#!/bin/sh
# launch-standalone.sh runs this with no arguments; the spike script drops the
# run length in ./secs and, to measure an unprivileged run while the stack is
# root's, the user to drop to in ./as_user.
DIR="$(dirname "$0")"
SECS="$(cat "$DIR/secs" 2>/dev/null || echo 60)"
if [ -s "$DIR/as_user" ] && [ "$(id -u)" = 0 ]; then
    exec su "$(cat "$DIR/as_user")" -s /bin/sh -c "exec '$DIR/movy-lab' '$SECS'"
fi
exec "$DIR/movy-lab" "$SECS"
